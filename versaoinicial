<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redaudit - Solução para Avaliação</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; scroll-behavior: smooth; }
        .loader { border-top-color: #2563eb; animation: spinner 0.8s linear infinite; }
        @keyframes spinner { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .editable-area:focus { outline: none; border-color: #3b82f6; background: white; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); }
        .audit-card { transition: all 0.3s ease; }
        .audit-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); }
    </style>
</head>
<body class="min-h-screen">

    <!-- LOGIN VIEW -->
    <div id="loginView" class="fixed inset-0 flex items-center justify-center bg-slate-900 z-[100] p-4">
        <div class="bg-white p-10 rounded-[2.5rem] shadow-2xl w-full max-w-md border border-slate-100">
            <div class="text-center mb-10">
                <div class="flex justify-center mb-6">
                    <div class="w-20 h-20 bg-blue-600 rounded-3xl flex items-center justify-center text-white shadow-xl rotate-3 border-4 border-blue-500">
                        <i data-lucide="shield-check" class="w-12 h-12 text-white"></i>
                    </div>
                </div>
                <h1 class="text-4xl font-black text-slate-900 italic tracking-tighter uppercase">redaudit</h1>
                <p class="text-blue-600 font-bold text-[10px] uppercase tracking-[0.2em] mt-2">Solução para Avaliação</p>
            </div>
            <form id="loginForm" class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[10px] font-black text-slate-400 uppercase ml-2">E-mail de Acesso</label>
                    <input type="email" id="email" required class="w-full px-5 py-4 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 font-medium bg-slate-50" placeholder="Utilizador">
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-black text-slate-400 uppercase ml-2">Senha</label>
                    <input type="password" id="password" required class="w-full px-5 py-4 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 font-medium bg-slate-50" placeholder="••••••••">
                </div>
                <button type="submit" class="w-full bg-slate-900 hover:bg-black text-white font-bold py-5 rounded-2xl transition-all shadow-lg active:scale-95 mt-4">Entrar no Redaudit</button>
            </form>
            <p id="loginError" class="text-red-500 text-xs mt-6 text-center hidden font-bold">Credenciais inválidas.</p>
        </div>
    </div>

    <!-- MAIN APP VIEW -->
    <div id="appView" class="hidden flex flex-col min-h-screen">
        <header class="bg-white border-b sticky top-0 z-50 shadow-sm">
            <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="bg-blue-600 p-2 rounded-xl text-white shadow-md">
                        <i data-lucide="brain-circuit" class="w-6 h-6"></i>
                    </div>
                    <div class="leading-tight">
                        <span class="text-2xl font-black italic tracking-tighter text-slate-900">redaudit</span>
                        <div class="text-[10px] text-slate-400 font-bold uppercase tracking-widest leading-none">Prof. André Luís L. Ribeiro</div>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <button onclick="toggleSettings()" class="text-slate-400 hover:text-blue-600 p-2 rounded-full hover:bg-blue-50 transition-all" title="Configurações">
                        <i data-lucide="settings" class="w-5 h-5"></i>
                    </button>
                    <button onclick="window.location.reload()" class="text-slate-400 hover:text-red-600 p-2 rounded-full hover:bg-red-50 transition-all" title="Sair">
                        <i data-lucide="log-out" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Settings (API Key) -->
        <div id="settingsBox" class="hidden bg-blue-700 p-6 animate-in slide-in-from-top duration-300">
            <div class="max-w-xl mx-auto flex flex-col md:flex-row gap-4 items-center text-white">
                <div class="flex-1 w-full">
                    <label class="text-[10px] font-black text-blue-100 uppercase block mb-2 ml-1 tracking-widest">Google Gemini API Key</label>
                    <input type="password" id="manualApiKey" class="w-full p-3 rounded-xl border-none text-sm outline-none shadow-inner text-slate-900 bg-white" placeholder="Insira a chave do Google AI Studio...">
                </div>
                <button onclick="saveApiKey()" class="bg-white text-blue-700 px-8 py-3 rounded-xl font-bold text-sm shadow-lg hover:bg-blue-50 transition-colors w-full md:w-auto mt-4 md:mt-6">Salvar Configuração</button>
            </div>
        </div>

        <main class="max-w-7xl mx-auto w-full p-6 md:p-10 space-y-10">
            <!-- Professional Header -->
            <div class="bg-white rounded-[2.5rem] p-8 md:p-12 border border-slate-200 shadow-sm flex flex-col md:flex-row gap-10 items-center relative overflow-hidden">
                <div class="w-32 h-32 bg-blue-600 rounded-[2.5rem] flex-shrink-0 flex items-center justify-center text-white shadow-2xl rotate-2 border-4 border-white">
                    <div class="text-center leading-none">
                        <p class="text-[10px] font-black uppercase opacity-60 mb-1">Vozes</p>
                        <p class="text-2xl font-black">Humanas</p>
                    </div>
                </div>
                <div class="flex-1 text-center md:text-left z-10">
                    <h2 class="text-3xl font-extrabold text-slate-900 mb-3 tracking-tight">Professor André Luís L. Ribeiro</h2>
                    <p class="text-slate-500 text-sm leading-relaxed max-w-4xl font-medium">
                        Graduado em Letras pela Unesp e pós-graduado em Design Educacional. 
                        Este motor de IA foi refinado para simular o rigor das bancas <strong>Enem 2025, Fuvest 2026 e Vunesp</strong>, garantindo avaliações humanizadas e técnicas.
                    </p>
                </div>
                <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-blue-50 rounded-full opacity-50"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
                <!-- Inputs Section (Left) -->
                <div class="lg:col-span-5 space-y-8">
                    <div class="bg-white p-8 rounded-[2.5rem] border border-slate-200 shadow-sm space-y-8">
                        <div>
                            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                                <i data-lucide="check-square" class="w-4 h-4 text-blue-600"></i> 1. Selecionar Grade de Avaliação
                            </h3>
                            <div class="grid grid-cols-3 gap-2">
                                <button onclick="setBanca('ENEM')" id="btn-ENEM" class="banca-btn py-4 text-xs font-black border-2 rounded-2xl transition-all border-blue-600 bg-blue-50 text-blue-700 shadow-sm">ENEM</button>
                                <button onclick="setBanca('VUNESP')" id="btn-VUNESP" class="banca-btn py-4 text-xs font-black border-2 rounded-2xl transition-all border-slate-100 text-slate-400 hover:bg-slate-50">VUNESP</button>
                                <button onclick="setBanca('FUVEST')" id="btn-FUVEST" class="banca-btn py-4 text-xs font-black border-2 rounded-2xl transition-all border-slate-100 text-slate-400 hover:bg-slate-50">FUVEST</button>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                                <i data-lucide="camera" class="w-4 h-4 text-blue-600"></i> 2. Captura da Folha (Frente/Verso)
                            </h3>
                            <div id="dropZone" class="border-2 border-dashed border-slate-200 rounded-[2rem] p-10 text-center cursor-pointer hover:border-blue-500 hover:bg-blue-50 transition-all group relative">
                                <i data-lucide="camera" class="w-12 h-12 text-blue-500 mx-auto mb-4 group-hover:scale-110 transition-transform"></i>
                                <p class="text-sm font-bold text-slate-700 uppercase tracking-tight">Digitalizar Manuscrito</p>
                                <p class="text-[10px] text-slate-400 mt-2 font-bold uppercase tracking-widest">Suporta múltiplas páginas</p>
                                <input type="file" id="fileInput" multiple accept="image/*" class="hidden">
                            </div>
                            <div id="preview" class="grid grid-cols-4 gap-2 mt-4"></div>
                        </div>

                        <button id="ocrBtn" disabled class="w-full bg-slate-900 text-white font-black py-5 rounded-2xl disabled:opacity-20 transition-all shadow-xl flex items-center justify-center gap-3 active:scale-95 group">
                            EXTRAIR TEXTO DO PAPEL <i data-lucide="scan-text" class="group-hover:rotate-12 transition-transform w-5 h-5"></i>
                        </button>
                    </div>
                </div>

                <!-- Column (Right): Review and Results -->
                <div class="lg:col-span-7 space-y-8">
                    <!-- Loading Status -->
                    <div id="status" class="hidden bg-white border border-blue-100 p-8 rounded-[2.5rem] shadow-sm flex items-center gap-8">
                        <div class="loader w-14 h-14 border-4 rounded-full"></div>
                        <div>
                            <p id="statusTitle" class="text-xl font-black text-slate-900 tracking-tight">O Redaudit está a processar...</p>
                            <p id="statusSub" class="text-sm text-slate-500 font-medium">Aguarde a resposta da IA Vision.</p>
                        </div>
                    </div>

                    <!-- Step 2: Edit & Review Area -->
                    <div id="editView" class="hidden space-y-8 animate-in fade-in slide-in-from-bottom duration-500">
                        <div class="bg-white p-10 rounded-[3rem] border border-slate-200 shadow-sm space-y-8">
                            <div class="flex justify-between items-center">
                                <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
                                    <i data-lucide="edit-3" class="w-4 h-4 text-blue-600"></i> Revisão dos Dados Extraídos
                                </h3>
                                <button onclick="clearForm()" class="text-red-500 text-[10px] font-black uppercase hover:underline">Limpar</button>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                <div class="space-y-1">
                                    <label class="text-[10px] font-black text-slate-400 uppercase ml-2 tracking-widest">Candidato</label>
                                    <input type="text" id="studentName" class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-5 py-4 text-sm font-bold outline-none focus:bg-white focus:border-blue-300 shadow-inner" placeholder="Nome identificado">
                                </div>
                                <div class="space-y-1">
                                    <label class="text-[10px] font-black text-slate-400 uppercase ml-2 tracking-widest">Frase Temática</label>
                                    <textarea id="essayTheme" rows="2" class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-5 py-4 text-sm font-bold outline-none resize-none focus:bg-white focus:border-blue-300 shadow-inner" placeholder="Tema da redação"></textarea>
                                </div>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-black text-slate-400 uppercase ml-2 tracking-widest block mb-1">Transcrição Literária (Verifique a Caligrafia)</label>
                                <div id="transcriptionBox" class="editable-area text-lg leading-loose text-slate-700 bg-slate-50 p-10 rounded-[2.5rem] border border-slate-100 italic min-h-[500px] transition-all font-medium shadow-inner" contenteditable="true" spellcheck="false"></div>
                                <p class="text-[10px] text-slate-400 mt-4 italic text-right font-bold uppercase tracking-widest leading-relaxed">
                                    * A nota técnica será calculada com base exatamente neste texto.
                                </p>
                            </div>

                            <button id="auditBtn" class="w-full bg-blue-600 text-white font-black py-6 rounded-[2.5rem] shadow-2xl shadow-blue-200 flex items-center justify-center gap-4 hover:bg-blue-700 transition-all transform active:scale-95 group">
                                EXECUTAR AUDITORIA (GRADE ${currentBanca}) <i data-lucide="award" class="w-7 h-7 group-hover:scale-125 transition-transform"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Final Report Presentation -->
                    <div id="reportView" class="hidden animate-in fade-in zoom-in duration-700"></div>
                </div>
            </div>
        </main>
        
        <footer class="p-16 text-center border-t border-slate-200 mt-20 opacity-40">
            <p class="text-xs font-bold uppercase tracking-[0.4em] mb-2 italic">redaudit - Inteligência Pedagógica</p>
            <p class="text-[10px] font-medium uppercase tracking-[0.2em]">Professor André Luís L. Ribeiro | Curso Vozes Humanas</p>
        </footer>
    </div>

    <!-- Notification Engine -->
    <div id="notif" class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-10 py-5 rounded-full shadow-2xl transition-all duration-500 z-[200] border border-slate-700 flex items-center gap-4 opacity-0 translate-y-10">
        <i data-lucide="info" class="w-6 h-6 text-blue-400"></i>
        <span id="notifText" class="font-bold tracking-tight text-sm uppercase"></span>
    </div>

    <script>
        // API CONFIGURATION
        let apiKey = ""; 
        const MODEL = "gemini-2.5-flash-preview-09-2025";
        
        let currentBanca = 'ENEM';
        let images = [];
        let auditData = null;

        // Initialize Lucide Icons
        lucide.createIcons();

        // Application State / Auth
        document.getElementById('loginForm').onsubmit = (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const pass = document.getElementById('password').value;
            if (email === 'brancoandreluis@gmail.com' && pass === 'redaudit') {
                document.getElementById('loginView').classList.add('hidden');
                document.getElementById('appView').classList.remove('hidden');
                loadApiKey();
                showNotif("Ligado ao Redaudit.");
            } else {
                document.getElementById('loginError').classList.remove('hidden');
            }
        };

        // UI Management Functions
        function toggleSettings() { document.getElementById('settingsBox').classList.toggle('hidden'); }
        
        function saveApiKey() {
            const k = document.getElementById('manualApiKey').value.trim();
            if (!k) { showNotif("Insira a chave da Google."); return; }
            localStorage.setItem('redaudit_key', k);
            apiKey = k;
            showNotif("Configuração de API Guardada.");
            toggleSettings();
        }

        function loadApiKey() {
            const k = localStorage.getItem('redaudit_key');
            if (k) { apiKey = k; document.getElementById('manualApiKey').value = k; }
        }

        function showNotif(msg) {
            const n = document.getElementById('notif');
            document.getElementById('notifText').innerText = msg;
            n.classList.remove('opacity-0', 'translate-y-10');
            setTimeout(() => n.classList.add('opacity-0', 'translate-y-10'), 6000);
        }

        function setBanca(b) {
            currentBanca = b;
            document.querySelectorAll('.banca-btn').forEach(btn => {
                btn.classList.remove('border-blue-600', 'bg-blue-50', 'text-blue-700');
                btn.classList.add('border-slate-100', 'text-slate-400');
            });
            document.getElementById(`btn-${b}`).classList.add('border-blue-600', 'bg-blue-50', 'text-blue-700');
            const auditBtn = document.getElementById('auditBtn');
            if(auditBtn) auditBtn.innerHTML = `EXECUTAR AUDITORIA (GRADE ${b}) <i data-lucide="award" class="w-7 h-7"></i>`;
            lucide.createIcons();
        }

        function clearForm() {
            document.getElementById('studentName').value = "";
            document.getElementById('essayTheme').value = "";
            document.getElementById('transcriptionBox').innerHTML = "";
            showNotif("Formulário Limpo.");
        }

        // Image Selection and Base64 Conversion
        document.getElementById('dropZone').onclick = () => document.getElementById('fileInput').click();
        document.getElementById('fileInput').onchange = async (e) => {
            const files = Array.from(e.target.files);
            images = [];
            document.getElementById('preview').innerHTML = '';
            for (let f of files) {
                const base64 = await new Promise(r => {
                    const reader = new FileReader();
                    reader.onload = () => r(reader.result);
                    reader.readAsDataURL(f);
                });
                images.push(base64.split(',')[1]);
                const img = document.createElement('img');
                img.src = base64;
                img.className = "h-14 w-full object-cover rounded-xl shadow-sm border border-slate-200";
                document.getElementById('preview').appendChild(img);
            }
            document.getElementById('ocrBtn').disabled = images.length === 0;
        };

        // Standardized API Call with Exponential Backoff
        async function callAI(payload, retries = 5) {
            const activeKey = apiKey || ""; 
            if (!activeKey) throw new Error("Chave Gemini não configurada. Use a engrenagem no topo.");
            
            const url = `https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent?key=${activeKey}`;
            
            for (let i = 0; i < retries; i++) {
                try {
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error?.message || "Erro na API");
                    const text = data.candidates[0].content.parts[0].text;
                    // Sanitize JSON response from model
                    return JSON.parse(text.replace(/```json|```/g, '').trim());
                } catch (err) {
                    if (i === retries - 1) throw err;
                    await new Promise(r => setTimeout(r, Math.pow(2, i) * 1000));
                }
            }
        }

        // --- STEP 1: OCR ---
        document.getElementById('ocrBtn').onclick = async () => {
            const status = document.getElementById('status');
            const editView = document.getElementById('editView');
            const ocrBtn = document.getElementById('ocrBtn');
            
            status.classList.remove('hidden');
            ocrBtn.disabled = true;
            editView.classList.add('hidden');
            document.getElementById('statusTitle').innerText = "Vision AI: Digitalizando...";

            try {
                const result = await callAI({
                    contents: [{
                        parts: [
                            { text: "Transcreva esta redação manuscrita integralmente. Identifique o Nome do Estudante e o Tema da Proposta se estiverem escritos no papel. Responda estritamente em JSON: { \"nome\": \"\", \"tema\": \"\", \"texto\": \"\" }" },
                            ...images.map(img => ({ inlineData: { mimeType: "image/png", data: img } }))
                        ]
                    }],
                    generationConfig: { responseMimeType: "application/json" }
                });

                document.getElementById('studentName').value = result.nome || "";
                document.getElementById('essayTheme').value = result.tema || "";
                document.getElementById('transcriptionBox').innerText = result.texto || "";
                
                editView.classList.remove('hidden');
                editView.scrollIntoView({ behavior: 'smooth' });
                showNotif("Digitalização pronta. Revise o texto.");
            } catch (err) {
                console.error(err);
                showNotif("Erro no OCR: " + err.message);
            } finally {
                status.classList.add('hidden');
                document.getElementById('ocrBtn').disabled = false;
            }
        };

        // --- STEP 2: AUDIT ---
        document.getElementById('auditBtn').onclick = async () => {
            const status = document.getElementById('status');
            const reportView = document.getElementById('reportView');
            const auditBtn = document.getElementById('auditBtn');

            status.classList.remove('hidden');
            auditBtn.disabled = true;
            reportView.classList.add('hidden');
            document.getElementById('statusTitle').innerText = `Auditoria Técnica: ${currentBanca}`;
            document.getElementById('statusSub').innerText = "Aplicando parâmetros estritos da banca selecionada.";

            // Dynamic Rubrics Injection
            const rubrics = {
                'ENEM': "Grade ENEM 2025: 5 Competências (0-200 pts cada). Exija rigorosamente os 5 elementos da Proposta de Intervenção (Agente, Ação, Meio, Efeito e Detalhamento).",
                'VUNESP': "Grade VUNESP: Critério A (Tema/Gênero - 11pts), Critério B (Estrutura/Coesão - 11pts), Critério C (Expressão - 6pts). Total 28 pts. Procure a tese dialética.",
                'FUVEST': "Grade FUVEST 2026: Aspecto A (Desenvolvimento e Organização), Aspecto B (Coerência e Articulação), Aspecto C (Correção e Expressividade). Foco total em maturidade intelectual e autoria argumentativa profunda."
            };

            const prompt = `
                Persona: Professor André Luís L. Ribeiro, especialista em grades de avaliação.
                Banca: ${currentBanca}. Regras: ${rubrics[currentBanca]}.
                Tema: ${document.getElementById('essayTheme').value}.
                Texto Transcrito: ${document.getElementById('transcriptionBox').innerText}.

                Realize uma auditoria profissional. Ignore critérios de outras bancas.
                Retorne APENAS JSON: { 
                    \"notaTotal\": \"STRING\", 
                    \"criterios\": [{\"nome\": \"\", \"nota\": \"\", \"detalhe\": \"\"}], 
                    \"fortes\": [], 
                    \"melhorias\": [], 
                    \"veredito\": \"STRING (Conclusão técnica com o tom do Prof. André)\" 
                }
            `;

            try {
                const report = await callAI({
                    contents: [{ parts: [{ text: prompt }] }],
                    systemInstruction: { parts: [{ text: "Você é o Redaudit, um motor de auditoria de elite que segue estritamente manuais de correção técnicos." }] },
                    generationConfig: { responseMimeType: "application/json" }
                });

                auditData = report;
                renderReport(report);
                reportView.classList.remove('hidden');
                reportView.scrollIntoView({ behavior: 'smooth' });
                showNotif("Auditoria Finalizada com Sucesso.");
            } catch (err) {
                console.error(err);
                showNotif("Erro na auditoria: " + err.message);
            } finally {
                status.classList.add('hidden');
                auditBtn.disabled = false;
            }
        };

        // Report Visualization Function
        function renderReport(data) {
            const container = document.getElementById('reportView');
            const student = document.getElementById('studentName').value || "Candidato";
            
            container.innerHTML = `
                <div class="bg-white p-12 rounded-[3.5rem] border border-slate-200 shadow-2xl border-t-[16px] border-t-blue-600 audit-card">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-8">
                        <div>
                            <h2 class="text-4xl font-black text-slate-900 tracking-tighter">${student}</h2>
                            <p class="text-[10px] font-black text-blue-600 uppercase tracking-[0.3em] mt-2">Laudo de Auditoria Redaudit • Grade ${currentBanca}</p>
                        </div>
                        <div class="bg-slate-900 text-white p-10 rounded-[2.5rem] text-center min-w-[180px] shadow-2xl transform hover:scale-105 transition-transform border-b-8 border-blue-600">
                            <p class="text-[10px] font-bold text-slate-400 uppercase mb-2 tracking-widest leading-none">Pontuação</p>
                            <p class="text-7xl font-black italic tracking-tighter">${data.notaTotal}</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                        <div class="bg-emerald-50 p-10 rounded-[3rem] border border-emerald-100 shadow-inner">
                            <h4 class="text-[10px] font-black text-emerald-600 uppercase tracking-widest mb-6 flex items-center gap-2">
                                <i data-lucide="check-circle" class="w-5 h-5"></i> Pontos de Excelência
                            </h4>
                            <ul class="space-y-3 text-sm text-emerald-900 font-semibold italic">
                                ${data.fortes.map(p => `<li>• ${p}</li>`).join('')}
                            </ul>
                        </div>
                        <div class="bg-amber-50 p-10 rounded-[3rem] border border-amber-100 shadow-inner">
                            <h4 class="text-[10px] font-black text-amber-600 uppercase tracking-widest mb-6 flex items-center gap-2">
                                <i data-lucide="trending-up" class="w-5 h-5"></i> Alavancas de Ganho
                            </h4>
                            <ul class="space-y-3 text-sm text-amber-900 font-semibold italic">
                                ${data.melhorias.map(p => `<li>• ${p}</li>`).join('')}
                            </ul>
                        </div>
                    </div>

                    <div class="space-y-6 mb-16">
                        <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.4em] ml-6">Detalhamento Técnico por Critério</h4>
                        ${data.criterios.map(c => `
                            <div class="p-8 bg-slate-50/50 rounded-[2.5rem] border border-slate-100 hover:bg-white hover:shadow-xl transition-all group">
                                <div class="flex justify-between items-center mb-4">
                                    <span class="font-black text-slate-800 text-sm tracking-tight group-hover:text-blue-600 transition-colors uppercase">${c.nome}</span>
                                    <span class="bg-white px-5 py-1.5 rounded-full text-blue-600 font-black text-sm border shadow-sm">${c.nota}</span>
                                </div>
                                <p class="text-xs text-slate-500 font-medium leading-relaxed">${c.detalhe}</p>
                            </div>
                        `).join('')}
                    </div>

                    <div class="bg-blue-600 text-white p-12 rounded-[3.5rem] relative overflow-hidden shadow-2xl">
                        <div class="relative z-10">
                            <h4 class="text-blue-200 text-[10px] font-black uppercase mb-6 tracking-widest leading-none">Veredito do Professor André Branco</h4>
                            <p class="text-2xl font-extrabold italic leading-tight text-blue-50">"${data.veredito}"</p>
                        </div>
                        <i data-lucide="quote" class="absolute -right-6 -bottom-6 w-56 h-56 text-white/10 -rotate-12"></i>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-16">
                        <button onclick="exportPDF()" class="bg-slate-900 text-white py-7 rounded-[2.5rem] font-bold flex items-center justify-center gap-4 shadow-2xl transform active:scale-95 transition-all">
                            <i data-lucide="file-down" class="text-blue-400 w-6 h-6"></i> GERAR LAUDO EM PDF
                        </button>
                        <a href="https://drive.google.com/drive/folders/1r3iBVqdX8Ry090GjJGHZ2GLr6aJwHRGZ?usp=sharing" target="_blank" class="bg-white border-2 border-slate-200 text-slate-600 py-7 rounded-[2.5rem] font-bold flex items-center justify-center gap-4 hover:border-blue-400 transition-all active:scale-95 shadow-lg">
                            <i data-lucide="cloud" class="text-blue-400 w-6 h-6"></i> ARQUIVAR NO DRIVE
                        </a>
                    </div>
                </div>
            `;
            lucide.createIcons();
        }

        // Professional PDF Export Engine
        async function exportPDF() {
            if (!auditData) return;
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            const student = document.getElementById('studentName').value || "Candidato";

            doc.setFont("helvetica", "bold");
            doc.setFontSize(24);
            doc.setTextColor(30, 58, 138);
            doc.text("Redaudit - Auditoria Pedagógica", 20, 25);
            
            doc.setFontSize(10);
            doc.setTextColor(150);
            doc.text("CURSO VOZES HUMANAS | PROFESSOR ANDRÉ LUÍS L. RIBEIRO", 20, 32);

            doc.setDrawColor(230, 230, 230);
            doc.line(20, 35, 190, 35);

            doc.setFontSize(12);
            doc.setTextColor(0);
            doc.text(`ALUNO(A): ${student.toUpperCase()}`, 20, 48);
            doc.text(`BANCA: ${currentBanca}`, 20, 55);
            doc.text(`NOTA ESTIMADA: ${auditData.notaTotal}`, 20, 62);

            let y = 80;
            auditData.criterios.forEach(c => {
                if (y > 260) { doc.addPage(); y = 20; }
                doc.setFont("helvetica", "bold");
                doc.setFontSize(11);
                doc.text(`${c.nome}: ${c.nota}`, 20, y);
                y += 6;
                doc.setFont("helvetica", "normal");
                doc.setFontSize(10);
                const split = doc.splitTextToSize(c.detalhe, 170);
                doc.text(split, 20, y);
                y += (split.length * 5) + 12;
            });

            doc.save(`Redaudit_${student.replace(/\s+/g, '_')}.pdf`);
        }
    </script>
</body>
